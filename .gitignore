# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Release signing material - never commit the real keystore or its
# passwords, whenever build.gradle.kts moves off the debug signingConfig
# it currently uses. Added pre-emptively, before one exists, since this is
# the kind of thing you want ignored before the first `git add`, not after.
*.jks
*.keystore
key.properties

# Firebase CLI's local deploy cache (e.g. hosting file-hash cache) -
# speeds up repeat `firebase deploy` runs, not meant for version control.
.firebase/
