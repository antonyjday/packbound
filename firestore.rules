rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isOwner(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isActiveGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.status == 'active';
    }

    // Basic user profile - readable by any signed-in user, writable only by self
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Anyone signed in can read group metadata IF they know the doc id
      // (needed to validate invite codes before joining)
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow delete: if isOwner(groupId);
      allow update: if isOwner(groupId) ||
        // Narrow exception: anyone can claim ownership of a currently
        // ownerless group (everyone left, including the owner - see
        // GroupService.leaveGroup) by setting themselves as ownerId, and
        // ONLY that field - used when rejoining an abandoned trip (see
        // GroupService.joinGroupByInviteCode). Firestore rules can't check
        // "is the members subcollection empty" directly, hence this
        // denormalized field instead.
        (isSignedIn() &&
          resource.data.ownerId == null &&
          request.resource.data.ownerId == request.auth.uid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerId']));

      match /members/{memberId} {
        // A member can read the member list only if they are already a
        // member. The second clause is narrower: anyone signed in can read
        // (only) their OWN potential doc regardless of whether it exists
        // yet - needed so joinGroupByInviteCode can check "am I already a
        // member of this group?" before deciding whether to write, without
        // that check itself being a chicken-and-egg permission-denied for
        // someone who isn't a member yet.
        allow read: if isMember(groupId) ||
          (isSignedIn() && request.auth.uid == memberId);
        // A user can add themselves as a member: either joining an existing
        // group (role must be 'member'), claiming ownership of a currently
        // ownerless one (role 'owner', group.ownerId already null - see the
        // group update rule above), or - in the same batch as group
        // creation - adding themselves as 'owner' when they're the creator.
        allow create: if isSignedIn() &&
          request.auth.uid == memberId &&
          (
            request.resource.data.role == 'member' ||
            (request.resource.data.role == 'owner' &&
              (
                get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid ||
                get(/databases/$(database)/documents/groups/$(groupId)).data.ownerId == null
              ))
          );
        // Only the owner can change roles or remove *other* members.
        allow update: if isOwner(groupId);
        // The owner can remove anyone; any member can remove themselves
        // (leaving the trip) - see GroupService.leaveGroup.
        allow delete: if isOwner(groupId) ||
          (isSignedIn() && request.auth.uid == memberId);
      }

      match /locations/{userId} {
        // Only group members can read the live location feed
        allow read: if isMember(groupId);
        // A user can only ever write their OWN location, only while a
        // member, and only while the trip is still active - prevents
        // writes into a group that's already been ended/cleaned up.
        allow write: if isSignedIn() &&
          request.auth.uid == userId &&
          isMember(groupId) &&
          isActiveGroup(groupId);
        // The owner can also delete a member's location doc directly -
        // e.g. when removing them from the convoy, so their marker
        // disappears immediately instead of lingering as a stale pin.
        allow delete: if isOwner(groupId);
      }
    }
  }
}
