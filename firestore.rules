rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function isMember(groupId) {
      return isSignedIn() &&
        exists(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid));
    }

    function isOwner(groupId) {
      return isSignedIn() &&
        get(/databases/$(database)/documents/groups/$(groupId)/members/$(request.auth.uid)).data.role == 'owner';
    }

    function isActiveGroup(groupId) {
      return get(/databases/$(database)/documents/groups/$(groupId)).data.status == 'active';
    }

    // Basic user profile - readable by any signed-in user, writable only by self
    match /users/{userId} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && request.auth.uid == userId;
    }

    match /groups/{groupId} {
      // Anyone signed in can read group metadata IF they know the doc id
      // (needed to validate invite codes before joining)
      allow read: if isSignedIn();
      allow create: if isSignedIn() && request.resource.data.createdBy == request.auth.uid;
      allow update, delete: if isOwner(groupId);

      match /members/{memberId} {
        // A member can read the member list only if they are already a member
        allow read: if isMember(groupId);
        // A user can add themselves as a member: either joining an existing
        // group (role must be 'member'), or - in the same batch as group
        // creation - adding themselves as 'owner' when they're the creator.
        allow create: if isSignedIn() &&
          request.auth.uid == memberId &&
          (
            request.resource.data.role == 'member' ||
            (request.resource.data.role == 'owner' &&
              get(/databases/$(database)/documents/groups/$(groupId)).data.createdBy == request.auth.uid)
          );
        // Only the owner can change roles or remove *other* members.
        allow update: if isOwner(groupId);
        // The owner can remove anyone; any member can remove themselves
        // (leaving the trip) - see GroupService.leaveGroup.
        allow delete: if isOwner(groupId) ||
          (isSignedIn() && request.auth.uid == memberId);
      }

      match /locations/{userId} {
        // Only group members can read the live location feed
        allow read: if isMember(groupId);
        // A user can only ever write their OWN location, only while a
        // member, and only while the trip is still active - prevents
        // writes into a group that's already been ended/cleaned up.
        allow write: if isSignedIn() &&
          request.auth.uid == userId &&
          isMember(groupId) &&
          isActiveGroup(groupId);
        // The owner can also delete a member's location doc directly -
        // e.g. when removing them from the convoy, so their marker
        // disappears immediately instead of lingering as a stale pin.
        allow delete: if isOwner(groupId);
      }
    }
  }
}
